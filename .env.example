# 변수 이름만 적은 예시입니다. 실제 값은 호스팅 환경의 비밀값(Secrets) 설정에 입력하세요.
# 이 파일을 .env로 복사해 값을 넣더라도 .env는 절대 커밋하지 마세요(.gitignore에 포함).

# 서버
PORT=8080
NODE_ENV=production
OPENAI_API_KEY=
DATABASE_URL=

# 이미지(교재 썸네일) 저장소 — S3 호환(Cloudflare R2 권장)
STORAGE_DRIVER=s3
S3_BUCKET=
# R2 예: https://<계정ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# 선택: 버킷 안 하위 폴더
S3_PREFIX=

# 선택: 빌드된 화면 폴더를 다른 곳에 둘 때만
# STATIC_DIR=

# 로컬 개발 전용(Vite가 /api를 Express로 전달)
# API_PROXY_TARGET=http://localhost:8080
